COMPOSE_PROJECT_NAME=ci
BACKEND_IMAGE=ci-backend
BACKEND_TAG=local
FRONTEND_IMAGE=ci-frontend
FRONTEND_TAG=local
HTTP_PORT=8080

# Credentials: use distinct, strong values in .env on every environment.
POSTGRES_USER=ci_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ci_platform
# Solo auth puede conectarse a este esquema. Genera el secreto con al menos 32 caracteres.
AUTH_JWT_ACCESS_SECRET=replace-with-a-minimum-32-character-random-secret
# Solo para desarrollo HTTP local. En producción HTTPS debe mantenerse en true.
AUTH_COOKIE_SECURE=true
SITES_INTERNAL_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
REDIS_PASSWORD=replace-with-a-long-random-password
RABBITMQ_DEFAULT_USER=ci_app
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-password
MINIO_ROOT_USER=ci_minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
# Perfil edge (TLS) y observabilidad (opcionales)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_PORT=3010
# Tras emitir el certificado: PROXY_CONF=default.ssl.conf y COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# PROXY_CONF=default.ssl.conf
# COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml

