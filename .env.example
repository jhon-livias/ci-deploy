COMPOSE_PROJECT_NAME=ci
BACKEND_IMAGE=ci-backend
BACKEND_TAG=local
FRONTEND_IMAGE=ci-frontend
FRONTEND_TAG=local
HTTP_PORT=8080

# Credentials: use distinct, strong values in .env on every environment.
POSTGRES_USER=ci_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ci_platform
# Solo auth puede conectarse a este esquema. Genera el secreto con al menos 32 caracteres.
AUTH_JWT_ACCESS_SECRET=replace-with-a-minimum-32-character-random-secret
# Solo para desarrollo HTTP local. En producción HTTPS debe mantenerse en true.
AUTH_COOKIE_SECURE=true
# reCAPTCHA v3: el secreto solo llega al servicio auth; la clave pública se sirve al navegador.
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=replace-with-your-recaptcha-v3-secret-key
RECAPTCHA_SITE_KEY=replace-with-your-recaptcha-v3-site-key
RECAPTCHA_MIN_SCORE=0.5
# Dominios registrados en Google, separados por comas y sin protocolo.
RECAPTCHA_ALLOWED_HOSTNAMES=localhost
# Login con Google. El secreto no se publica. La URL de retorno debe coincidir con la consola de Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://sistema-idiomas.uprit.edu.pe/api/v1/auth/google/callback
SITES_INTERNAL_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
REDIS_PASSWORD=replace-with-a-long-random-password
# Los servicios NestJS reciben REDIS_HOST=redis y REDIS_PASSWORD desde docker-compose.
RABBITMQ_DEFAULT_USER=ci_app
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-password
# websocket, webhook o websocket,webhook. La URL del webhook no la elige el usuario.
NOTIFICATION_TRANSPORTS=websocket
# Correo de recuperación por Gmail corporativo. La clave es una contraseña de aplicación, no la de la cuenta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=correo@tu-dominio.com
# SMTP_PASSWORD=replace-with-the-gmail-app-password
# SMTP_FROM=Centro de Idiomas UPRIT <correo@tu-dominio.com>
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/ci/notifications
# NOTIFICATION_WEBHOOK_SECRET=replace-with-a-minimum-32-character-random-secret
MINIO_ROOT_USER=ci_minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
# Perfil edge (TLS) y observabilidad (opcionales)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_PORT=3010
# Tras emitir el certificado: PROXY_CONF=default.ssl.conf y COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# PROXY_CONF=default.ssl.conf
# COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml

